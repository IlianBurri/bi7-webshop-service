<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="webshop-hibernate" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>ch.suva.bi7.webshop.service.db.entity.ArtikelEntity</class>
        <class>ch.suva.bi7.webshop.service.db.entity.BenutzerEntity</class>
        <class>ch.suva.bi7.webshop.service.db.entity.AdresseEntity</class>
        <class>ch.suva.bi7.webshop.service.db.entity.BestellungEntity</class>
        <class>ch.suva.bi7.webshop.service.db.entity.WarenkorbEintragEntity</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MariaDBDialect"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>

